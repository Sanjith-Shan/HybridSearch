<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated from the shared contract. Broker uses the client stubs, FakeShard the server base. -->
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Core.Api" Version="2.84.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="../../proto/hybridsearch/v1/shard.proto" ProtoRoot="../../proto" GrpcServices="Both" Link="Protos/shard.proto" />
  </ItemGroup>
</Project>
