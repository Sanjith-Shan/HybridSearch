{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:8080",
  "Broker": {
    "DataRoot": "../../data",
    "Topology": {
      "Slices": [
        { "Id": 0, "Replicas": [ "http://localhost:50051" ] }
      ]
    },
    "Search": {
      "DefaultK": 10,
      "MaxK": 100,
      "MaxQueryChars": 512,
      "DefaultDeadlineMs": 300,
      "CandidateDepth": 100,
      "RerankDepth": 20,
      "Fusion": "weighted",
      "RrfK": 60,
      "Alpha": 0.8,
      "Normalization": "zscore",
      "SnippetChars": 240,
      "DenseBeamWidth": 0,
      "DenseBeamWidthShrunk": 32,
      "ShardGraceMs": 3,
      "MinFetchMs": 30
    },
    "Hedging": {
      "Enabled": true,
      "Quantile": 0.95,
      "BudgetRatio": 0.05,
      "BurstTokens": 10,
      "MinSamples": 50,
      "MinDelayMs": 1,
      "WindowSeconds": 60,
      "FailoverOnError": true
    },
    "Degradation": {
      "PlanningQuantile": 0.9,
      "MinSamples": 20,
      "InFlightThresholds": [ 64, 128, 256 ]
    },
    "Models": {
      "QueryEncoderKind": "onnx",
      "QueryEncoderDir": "models/query-encoder",
      "RerankerDir": "models/reranker",
      "PreferInt8Reranker": true,
      "RerankBatchSize": 16,
      "RerankMaxTokens": 256,
      "QueryMaxTokens": 64
    },
    "Autocomplete": {
      "QueryLogPath": "raw/msmarco/queries.train.tsv",
      "TopK": 10,
      "SpellCorrection": true
    },
    "Events": { "Directory": "events", "QueueCapacity": 10000, "MaxBatch": 100 },
    "Experiments": { "ConfigPath": "experiments.json" },
    "Health": { "IntervalMs": 2000, "TimeoutMs": 1000 },
    "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
    "Otel": { "Exporter": "otlp" }
  }
}
