# Rendered by the nginx image's envsubst step (BROKER_UPSTREAM).
server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Content-Security-Policy "default-src 'self'; connect-src 'self' http://localhost:4318; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'" always;

  location /api/search/stream {
    proxy_pass ${BROKER_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;          # SSE: deliver the lexical event immediately
    proxy_cache off;
    proxy_read_timeout 30s;
  }

  location /api/ {
    proxy_pass ${BROKER_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # SPA routes (/doc/:id, /experiments) fall back to index.html.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
