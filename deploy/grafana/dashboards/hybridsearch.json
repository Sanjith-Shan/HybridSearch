{
  "title": "HybridSearch \u2014 serving and SLO",
  "uid": "hybridsearch-slo",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Search p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(hs_search_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(hs_search_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hs_search_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(hs_search_requests_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Bad-event ratio vs SLO (0.5%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hs:search_bad_ratio:rate5m",
          "legendFormat": "bad ratio 5m"
        },
        {
          "refId": "B",
          "expr": "hs:search_bad_ratio:rate1h",
          "legendFormat": "bad ratio 1h"
        },
        {
          "refId": "C",
          "expr": "vector(0.005)",
          "legendFormat": "SLO budget"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error budget remaining (30d)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - (sum(increase(hs_search_requests_total{outcome!=\"ok\"}[30d])) + sum(increase(hs_search_duration_seconds_count[30d])) - sum(increase(hs_search_duration_seconds_bucket{le=\"0.3\"}[30d]))) / clamp_min(sum(increase(hs_search_requests_total[30d])) * 0.005, 1e-9)",
          "legendFormat": "remaining"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Shard p99 by shard",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, shard) (rate(hs_shard_duration_seconds_bucket[1m])))",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Shard failures and partial results",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (shard, reason) (rate(hs_shard_failures_total[1m]))",
          "legendFormat": "fail {{shard}} {{reason}}"
        },
        {
          "refId": "B",
          "expr": "sum by (shard) (rate(hs_shard_partial_total[1m]))",
          "legendFormat": "partial {{shard}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hedging: extra load and win rate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hs:hedge_extra_load:ratio5m",
          "legendFormat": "extra load"
        },
        {
          "refId": "B",
          "expr": "sum(rate(hs_hedges_won_total[5m])) / clamp_min(sum(rate(hs_hedges_sent_total[5m])), 1e-9)",
          "legendFormat": "hedge win rate"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Degradation steps / s",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (step) (rate(hs_degradation_total[1m]))",
          "legendFormat": "{{step}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Stage latency p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hs_encode_duration_seconds_bucket[1m])))",
          "legendFormat": "encode"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hs_rerank_duration_seconds_bucket[1m])))",
          "legendFormat": "rerank"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(hs_suggest_duration_seconds_bucket[1m])))",
          "legendFormat": "suggest"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Feedback events / s (M9)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(hs_events_ingested_total[1m]))",
          "legendFormat": "ingested {{type}}"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(hs_events_dropped_total[1m]))",
          "legendFormat": "dropped {{reason}}"
        }
      ]
    }
  ]
}
